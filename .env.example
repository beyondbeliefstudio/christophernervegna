# Analytics (components stay silent in dev and when these are empty)
# GTM-XXXXXXX (Tag Manager) or G-XXXXXXX (GA4)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_AHREFS_DATA_KEY=

# Userback feedback widget
PUBLIC_USERBACK_TOKEN=

# Set to "true" on a staging deploy to keep it out of search
PUBLIC_NOINDEX=

# Netlify function secrets (set in the Netlify UI, not here in production)
ANTHROPIC_API_KEY=
ASK_MODEL=
