---
// "Do you actually write the code?" A bento of mixed tiles, each with a
// sticker-style illustration from src/icons/art-*.svg.
// COMPONENTS
import { Icon } from "astro-icon/components";
import Heading from "@/components/Heading.astro";
import SecHead from "@/components/SecHead.astro";

// DATA
import { toolsData } from "@/data/homeData";
---

<section id="build" data-progress-nav-anchor aria-labelledby="build-title">
  <div class="container container-md">
    <SecHead
      id="build-title"
      bubble="Do you actually write the code?"
      title="Any platform you run on. Or no platform at all."
    />

    <div class="bento" data-reveal="stagger">
      <div class="bento__tile bento__tile--card bento__a">
        <div class="sticker-art bento__art">
          <Icon name="art-layers" aria-hidden="true" />
        </div>
        <Heading tag="h3" size="m">
          Whatever your team uses
        </Heading>
        <p>
          I&rsquo;m not precious about tools. If your team lives in Webflow or WordPress, I&rsquo;ll
          build there and build it well. I&rsquo;ve launched real sites on both, along with
          Squarespace, Wix and BentoBox&rsquo;s own platform, where I spend most days pushing past
          what the templates allow with custom CSS and JavaScript. A platform limitation rarely
          means no. There&rsquo;s almost always a way.
        </p>
      </div>

      <div class="bento__tile bento__tile--red bento__b">
        <div class="sticker-art bento__art">
          <Icon name="art-blank" aria-hidden="true" />
        </div>
        <Heading tag="h3" size="m">
          Or a blank file
        </Heading>
        <p>
          My favorite way to build, though, is from a blank file: HTML, CSS and JavaScript,
          organized in Astro and deployed through Git and Netlify. With no visual editor between me
          and the code, I can read exactly why something broke. And when a design calls for
          something a page builder can&rsquo;t do, I just write it.
        </p>
        <pre class="bento__code" aria-hidden="true"><code>&lt;section class="hero"&gt;
  &lt;h1&gt;Hand-built.&lt;/h1&gt;
&lt;/section&gt;</code></pre>
      </div>

      <div class="bento__tile bento__tile--ink bento__c">
        <div class="sticker-art bento__art">
          <Icon name="art-phone" aria-hidden="true" />
        </div>
        <Heading tag="h3" size="m">
          The unglamorous parts
        </Heading>
        <p>
          Restaurants get sued over the smallest accessibility issues, so at BentoBox accessibility
          and performance came first on every site. Mine work on a phone from the first line, meet
          accessibility standards, load fast, and are set up so search engines see what they should.
        </p>
      </div>

      <div class="bento__tile bento__tile--card bento__d">
        <div class="sticker-art bento__art">
          <Icon name="art-toolbox" aria-hidden="true" />
        </div>
        <Heading tag="h3" size="m">
          What I build with
        </Heading>
        <ul class="bento__chips">
          {toolsData.map(tool => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: var(--_spacing---section-space--small);

    &__tile {
      position: relative;
      padding: clamp(1.75rem, 3vw, 2.5rem);
      border-radius: var(--border-radius-large);

      :global(h3) {
        padding-right: 7rem;
      }

      p {
        margin-top: 1rem;
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      &:hover :global(svg) {
        transform: rotate(-6deg) scale(1.06);
      }

      &--card {
        background: var(--surface-secondary);
      }

      &--red {
        background: var(--brand-primary);
        color: var(--content-on-primary);
      }

      &--ink {
        background: var(--dark-900);
        color: var(--light-100);

        p {
          color: color-mix(in srgb, var(--light-100) 80%, transparent);
        }
      }
    }

    &__art {
      position: absolute;
      top: -22px;
      right: 28px;
      z-index: 2;
      width: 6rem;
      height: 6rem;
      transform: rotate(8deg);
    }

    &__a {
      grid-column: 1 / span 7;
    }

    &__b {
      grid-column: 8 / span 5;
      grid-row: span 2;
      display: flex;
      flex-direction: column;

      .bento__art {
        transform: rotate(-7deg);
      }
    }

    &__c {
      grid-column: 1 / span 7;

      .bento__art {
        transform: rotate(-5deg);
      }
    }

    &__d {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: center;
      gap: 1rem 2rem;
      padding-right: 9.375rem;

      :global(h3) {
        padding-right: 0;
      }
    }

    &__code {
      margin-top: auto;
      padding: 1.25rem;
      overflow-x: auto;
      border-radius: 1rem;
      background: rgba(0, 0, 0, 0.18);
      font-family: var(--tertiary-family);
      font-size: 0.875rem;
      line-height: 1.6;
      white-space: pre;
    }

    &__b p {
      margin-bottom: 1.75rem;
    }

    &__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;

      li {
        padding: 6px 11px;
        border-radius: var(--border-radius-round);
        background: var(--surface-primary);
        font-size: 0.8125rem;
      }
    }

    @media (max-width: 1100px) {
      &__a {
        grid-column: 1 / -1;
      }

      &__b {
        grid-column: 1 / span 6;
        grid-row: auto;
      }

      &__c {
        grid-column: 7 / span 6;
      }
    }

    @media (max-width: 860px) {
      &__d {
        grid-template-columns: 1fr;
        padding-top: 4.5rem;
        padding-right: clamp(1.75rem, 3vw, 2.5rem);
      }

      &__art {
        width: 5rem;
        height: 5rem;
      }
    }

    @media (max-width: 720px) {
      &__b,
      &__c {
        grid-column: 1 / -1;
      }
    }
  }
</style>
