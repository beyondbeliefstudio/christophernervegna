---
// Off the clock: copy in the middle, stickers scattered around it. Drag them;
// click one to read the story. Behavior lives in initStickers (app.js); each
// sticker carries its story in data-* attributes for the modal.
// COMPONENTS
import { Icon } from "astro-icon/components";
import { getImage } from "astro:assets";
import Heading from "@/components/Heading.astro";

// DATA
import { stickersData } from "@/data/stickersData";

// Photos are optimized at build time; the modal swaps them in by URL.
const stickers = await Promise.all(
  stickersData.map(async s => ({
    ...s,
    photoSrc: s.photo ? (await getImage({ src: s.photo, width: 960, format: "webp" })).src : "",
  }))
);
---

<section id="offclock" data-progress-nav-anchor aria-labelledby="offclock-title">
  <div class="container container-md">
    <div class="stickers">
      <div class="stickers__board" data-board>
        <div class="stickers__center">
          <span class="bubble bubble--red stickers__bubble">
            And when you&rsquo;re not working?
          </span>
          <Heading tag="h2" size="xxl" id="offclock-title" class="stickers__title">
            The stuff that isn&rsquo;t on my resume.
          </Heading>
          <p>Drag them around. Click one and I&rsquo;ll tell you more.</p>
        </div>
        {stickers.map(s => (
          <button
            class="sticker"
            type="button"
            data-sticker
            data-x={s.x}
            data-y={s.y}
            data-kicker={s.kicker}
            data-title={s.title}
            data-body={s.body}
            data-extra={s.extra}
            data-photo={s.photoSrc || undefined}
            data-photo-alt={s.photoAlt}
            data-photo-pos={s.photoPos}
            aria-label={`${s.label}: tell me more`}
            style={`left: calc(${s.x}% - 66px); top: ${s.y}px; transform: rotate(${s.rot}deg);`}
          >
            <Icon name={`sticker-${s.id}`} aria-hidden="true" />
          </button>
        ))}
      </div>
    </div>
  </div>

  <dialog class="modal" data-modal aria-labelledby="sticker-title">
    <div class="modal__card" tabindex="-1" autofocus>
      <div class="modal__hero" data-modal-hero>
        <img class="modal__photo" data-modal-photo alt="" hidden />
        <div class="modal__art" data-modal-art aria-hidden="true"></div>
        <button class="modal__close" type="button" data-close aria-label="Close">
          <Icon name="close" aria-hidden="true" />
        </button>
      </div>
      <div class="modal__content">
        <h3 class="modal__title" id="sticker-title" data-f="title"></h3>
        <p class="modal__body" data-f="body"></p>
        <p class="modal__extra" data-f="extra"></p>
      </div>
    </div>
  </dialog>
</section>

<style lang="scss">
  .stickers {
    position: relative;
    overflow: hidden;
    padding: 2.5rem 1.5rem;
    border-radius: var(--border-radius-xl);
    background: var(--surface-secondary);

    &__board {
      position: relative;
      max-width: 77.5rem;
      height: 45rem;
      margin: 0 auto;
    }

    &__center {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(35rem, 90%);
      text-align: center;
      transform: translate(-50%, -50%);
      pointer-events: none;

      p {
        margin-top: 1.25rem;
        color: var(--content-secondary);
        font-size: var(--_typography---font-size--text-large);
      }
    }

    &__bubble {
      transform: rotate(-4deg);
    }

    :global(.stickers__title) {
      margin-top: 1.75rem;
      line-height: 1;
    }

    @media (max-width: 720px) {
      padding: 1.5rem 0.75rem;
      border-radius: var(--border-radius-large);

      &__board {
        height: 52.5rem;
      }

      &__center {
        top: 25.625rem;
      }
    }
  }

  .sticker {
    position: absolute;
    z-index: 1;
    width: 132px;
    height: 132px;
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: none;

    &:active {
      cursor: grabbing;
    }

    &:focus-visible {
      outline-offset: 6px;
      border-radius: 12px;
    }

    :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
      filter: var(--sticker-outline);
      animation: sticker-bob 6s ease-in-out infinite;
      pointer-events: none;
    }

    &:nth-of-type(2n) :global(svg) {
      animation-delay: -2s;
    }

    &:nth-of-type(3n) :global(svg) {
      animation-delay: -4s;
    }

    @media (max-width: 720px) {
      width: 88px;
      height: 88px;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(svg) {
        animation: none;
      }
    }
  }

  @keyframes sticker-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Sticker story card: a colored header with the sticker blown up and
     dropping in, then the story. Header color rotates per sticker. */
  .modal {
    width: 100%;
    max-width: min(32.5rem, calc(100vw - 2rem));
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;

    &::backdrop {
      background: rgba(20, 18, 16, 0.55);
      backdrop-filter: blur(3px);
    }

    &__card {
      position: relative;
      overflow: hidden;
      border-radius: var(--border-radius-xl);
      background: var(--surface-primary);
      color: var(--content-primary);
      box-shadow: 0 40px 80px -30px rgba(20, 18, 16, 0.6);
      transform: rotate(-1.5deg);
      outline: none;
    }

    &[open] .modal__card {
      animation: modal-pop 0.5s var(--ease-out);
    }

    &__hero {
      --hero-bg: var(--brand-primary);
      --hero-dot: rgba(255, 255, 255, 0.22);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 13.5rem;
      background-color: var(--hero-bg);
      background-image: radial-gradient(var(--hero-dot) 1.6px, transparent 1.6px);
      background-size: 18px 18px;

      &[data-tone="ink"] {
        --hero-bg: var(--dark-900);
        --hero-dot: rgba(255, 255, 255, 0.14);
      }

      &[data-tone="crema"] {
        --hero-bg: var(--light-200);
        --hero-dot: rgba(20, 18, 16, 0.12);
      }

      &[data-tone="blush"] {
        --hero-bg: var(--brand-primary-light);
        --hero-dot: rgba(217, 48, 31, 0.18);
      }
    }

    &__art {
      position: relative;
      width: 10rem;
      height: 10rem;

      :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        filter: drop-shadow(5px 0 0 #fff) drop-shadow(-5px 0 0 #fff) drop-shadow(0 5px 0 #fff)
          drop-shadow(0 -5px 0 #fff) drop-shadow(0 18px 22px rgba(20, 18, 16, 0.3));
      }
    }

    /* With a photo, the photo fills the header and the sticker drops to the
       bottom-right corner, half over the photo and half over the card. */
    &__hero.has-photo {
      height: clamp(16rem, 60vw, 21rem);
      background: var(--dark-900);

      .modal__art {
        position: absolute;
        right: 1.5rem;
        bottom: -2.75rem;
        z-index: 2;
        width: 6.5rem;
        height: 6.5rem;
      }
    }

    &__photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__photo[hidden] {
      display: none;
    }

    /* Keep the title clear of the sticker that overlaps the content. */
    &__card.has-photo .modal__title {
      padding-right: 6.5rem;
    }

    /* Phones: a smaller sticker, and the title drops below it instead of squeezing. */
    @media (max-width: 480px) {
      &__hero.has-photo .modal__art {
        bottom: -2rem;
        width: 4.75rem;
        height: 4.75rem;
      }

      &__card.has-photo .modal__title {
        margin-top: 2.75rem;
        padding-right: 0;
      }
    }

    &[open] .modal__art {
      animation: sticker-drop 0.7s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    &__close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: var(--border-width) solid var(--dark-900);
      border-radius: 50%;
      background: var(--surface-primary);
      box-shadow: 3px 3px 0 var(--dark-900);
      color: var(--content-primary);
      cursor: pointer;
      transition: transform var(--duration-fast);

      &:hover {
        transform: rotate(90deg);
      }

      :global(svg) {
        width: 18px;
        height: 18px;
      }
    }

    &__content {
      padding: 0 2.25rem 2.25rem;
    }

    &__title {
      margin-top: 1.75rem;
      font-family: var(--primary-family);
      font-size: clamp(2rem, 6vw, 2.75rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1;
    }

    &__body {
      margin-top: 1rem;
      font-size: 1.125rem;
      line-height: 1.6;
    }

    /* The second line reads like a note pinned on: offset ink shadow, slight tilt. */
    &__extra {
      margin-top: 1.5rem;
      padding: 1rem 1.25rem;
      border: var(--border-width) solid var(--dark-900);
      border-radius: 1rem;
      background: var(--light-200);
      box-shadow: var(--shadow-offset);
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.5;
      transform: rotate(1deg);
    }

    @media (prefers-reduced-motion: reduce) {
      &[open] .modal__card,
      &[open] .modal__art {
        animation: none;
      }
    }
  }

  @keyframes sticker-drop {
    from {
      opacity: 0;
      transform: translateY(-40px) rotate(-25deg) scale(0.6);
    }
    to {
      opacity: 1;
      transform: rotate(var(--art-rot, -6deg));
    }
  }

  @keyframes modal-pop {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(2deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: rotate(-1.5deg);
    }
  }
</style>
