---
// Visitor poll. Not on the page right now; drop <Poll /> into a section to use it.
// One random question per visit from src/data/polls.json. Behavior lives in
// initPoll (app.js); tallies come from netlify/functions/poll.mjs (Netlify Blobs).
// DATA
import polls from "@/data/polls.json";
---

<div class="poll" data-poll>
  <div class="poll__card">
    <p class="poll__kicker">Settle a debate for me</p>
    <h3 class="poll__q" data-poll-q>
      {polls[0].q}
    </h3>
    <div class="poll__options" role="group" data-poll-options aria-describedby="poll-status"></div>
    <p class="poll__mine" data-poll-mine hidden></p>
    <div class="poll__foot">
      <p class="poll__status" id="poll-status" data-poll-status aria-live="polite">
        Pick one. Then you&rsquo;ll see how everyone else voted.
      </p>
      <button class="btn light poll__next" type="button" data-poll-next>
        Ask me another
      </button>
    </div>
  </div>
  <script type="application/json" id="poll-data" set:html={JSON.stringify(polls)} />
</div>

<style lang="scss">
  .poll {
    &__card {
      padding: clamp(1.5rem, 3vw, 2rem);
      border-radius: var(--border-radius-large);
      background: var(--dark-900);
      color: var(--light-100);
    }

    &__kicker {
      margin-bottom: 0.75rem;
      color: var(--brand-primary);
      font-size: 0.875rem;
      font-weight: 600;
    }

    &__q {
      font-family: var(--primary-family);
      font-size: clamp(1.625rem, 2.6vw, 2.125rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.02;
    }

    &__options {
      display: grid;
      gap: 0.625rem;
      margin-top: 1.625rem;
    }

    /* Options are built by app.js, so they need the global hook. */
    &__options :global(.poll__opt) {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 50px;
      padding: 0.875rem 1.25rem;
      overflow: hidden;
      border: 0;
      border-radius: var(--border-radius-medium);
      background: var(--surface-primary);
      color: var(--content-primary);
      font: inherit;
      font-size: 1rem;
      text-align: left;
      cursor: pointer;
      transition:
        transform var(--duration-fast),
        box-shadow var(--duration-fast);
    }

    &__options :global(.poll__opt:not([disabled]):hover) {
      transform: translateY(-2px);
      box-shadow: 0 0 0 2px var(--brand-primary);
    }

    &__options :global(.poll__opt[disabled]) {
      cursor: default;
    }

    &__options :global(.poll__fill) {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--pct, 0%);
      background: var(--light-200);
      transition: width 0.9s var(--ease-out);
    }

    &__options :global(.poll__opt.is--mine) {
      box-shadow: 0 0 0 2px var(--brand-primary);
    }

    &__options :global(.poll__opt.is--mine .poll__fill) {
      background: color-mix(in srgb, var(--brand-primary) 28%, var(--surface-primary));
    }

    &__options :global(.poll__label),
    &__options :global(.poll__pct) {
      position: relative;
    }

    &__options :global(.poll__label) {
      flex: 1;
    }

    &__options :global(.poll__pct) {
      font-family: var(--tertiary-family);
      font-size: 0.9375rem;
      opacity: 0;
      transition: opacity 0.3s 0.4s;
    }

    &:global(.is--voted) .poll__options :global(.poll__pct) {
      opacity: 1;
    }

    &__mine {
      margin-top: 1.375rem;
      padding: 0.875rem 1.125rem;
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.08);
      font-size: 0.9375rem;
      font-style: italic;
      line-height: 1.5;
    }

    &__foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    &__status {
      color: color-mix(in srgb, var(--light-100) 65%, transparent);
      font-size: 0.875rem;
    }
  }
</style>
