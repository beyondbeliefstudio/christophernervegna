---
// "AI makes me faster. It doesn't make the decisions." A centered intro on how I
// work with it, then three tools fanned like cards.
// COMPONENTS
import Heading from "@/components/Heading.astro";
import SecHead from "@/components/SecHead.astro";
import { Image } from "astro:assets";

// IMAGES
import cookbookShot from "@/assets/ai/cookbook.png";
import cartiqShot from "@/assets/ai/cartiq.png";
import homeplateShot from "@/assets/ai/homeplate.png";
const shots = { cookbook: cookbookShot, cartiq: cartiqShot, homeplate: homeplateShot };

// DATA
import { aiProjectsData } from "@/data/homeData";
---

<section id="ai" class="ai" data-progress-nav-anchor aria-labelledby="ai-title">
  <div class="container container-md">
    <div class="ai__intro">
      <SecHead
        id="ai-title"
        bubble="Do you use AI?"
        red
        center
        title="AI makes me faster.<br /> It doesn&rsquo;t make the decisions."
      />
      <div class="ai__text" data-reveal="up">
        <p>
          The heavy lifting happens up front. Before an agent builds anything, I&rsquo;ve set up the
          design system and the components it can use, and written down how I work: how I name
          things, how I structure a page, what I never want to see.
        </p>
        <p>
          Once that&rsquo;s in place, I let it run. I check in along the way to steer, and I make
          the calls on anything that matters. Sites launch sooner, and they still look and read like
          a person made them. If you can tell AI was involved, I did it wrong.
        </p>
      </div>
    </div>

    <Heading tag="h3" size="m" weight="fw600" class="ai__lead" data-reveal="lines">
      I also reach for it when something at work or at home needs a tool that doesn&rsquo;t exist
      yet.
    </Heading>

    <div class="fan" data-reveal="stagger">
      {aiProjectsData.map(p => (
        <article class:list={["fan__card", `fan__card--${p.tone}`]}>
          <p class="fan__tag">{p.tag}</p>
          <Heading tag="h4" size="l" class="fan__title">
            {p.name}
          </Heading>
          <p class="fan__what">{p.what}</p>
          <div class="fan__shot">
            <Image
              src={shots[p.img]}
              alt={p.shot}
              widths={[480, 720, 960]}
              sizes="(max-width: 900px) 92vw, 30vw"
              loading="lazy"
            />
          </div>
          <p class="fan__stack">{p.stack}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .ai {
    &__intro {
      text-align: center;
    }

    &__text {
      max-width: 45rem;
      margin: 2rem auto 0;
    }

    &__text p {
      font-size: var(--_typography---font-size--text-large);
      line-height: 1.7;

      & + p {
        margin-top: 1.375rem;
      }
    }

    :global(.ai__lead) {
      max-width: 42.5rem;
      margin: 7.5rem auto 0;
      text-align: center;
      line-height: 1.25;
    }
  }

  .fan {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 1.5rem;
    margin-top: 3.5rem;

    &__card {
      display: flex;
      flex-direction: column;
      padding: 1.75rem 1.5rem 1.5rem;
      border-radius: var(--border-radius-large);

      &:nth-child(1) {
        transform: rotate(-4deg) translateY(28px);
      }

      &:nth-child(3) {
        transform: rotate(4deg) translateY(28px);
      }

      &--ink {
        background: var(--dark-900);
        color: var(--light-100);
      }

      &--red {
        background: var(--brand-primary);
        color: var(--content-on-primary);
      }

      &--crema {
        background: var(--light-200);
        color: var(--content-primary);
      }
    }

    &__tag {
      font-family: var(--tertiary-family);
      font-size: 0.75rem;
      opacity: 0.75;
    }

    /* White on Campari only just passes contrast, so no fading there. */
    &__card--red .fan__tag,
    &__card--red .fan__stack {
      opacity: 1;
    }

    :global(.fan__title) {
      margin-top: 0.625rem;
    }

    &__what {
      margin-top: 0.875rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    &__shot {
      margin-top: 1.375rem;
      overflow: hidden;
      border-radius: 1rem;

      img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: top left;
      }
    }

    &__stack {
      margin-top: 1rem;
      font-size: 0.875rem;
      opacity: 0.75;
    }

    @media (max-width: 900px) {
      grid-template-columns: 1fr;

      &__card:nth-child(n) {
        transform: none;
      }
    }
  }
</style>
