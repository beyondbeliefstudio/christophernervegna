---
// Netlify form with a honeypot and Netlify's reCAPTCHA. Posts to /submit-contact/, the thank-you page.
// COMPONENTS
import Buttons from "@/components/Buttons.astro";
---

<form
  name="contact"
  method="POST"
  action="/submit-contact/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="contact-form"
  data-reveal="up"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>
      Don't fill this out if you're human:{" "}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="form-row">
    <div class="form-group">
      <label for="cf-name">
        Name <span class="required">*</span>
      </label>
      <input type="text" id="cf-name" name="name" autocomplete="name" required />
    </div>
    <div class="form-group">
      <label for="cf-email">
        Email <span class="required">*</span>
      </label>
      <input type="email" id="cf-email" name="email" autocomplete="email" required />
    </div>
  </div>

  <div class="form-group">
    <label for="cf-company">Company and role</label>
    <input type="text" id="cf-company" name="company" autocomplete="organization" />
  </div>

  <div class="form-group">
    <label for="cf-message">
      What&rsquo;s on your mind? <span class="required">*</span>
    </label>
    <textarea id="cf-message" name="message" required></textarea>
  </div>

  <!-- Netlify-managed reCAPTCHA v2, same setup as Quantum Home Cares. Netlify injects
       the widget at deploy and rejects failed challenges before the submission is
       stored, so no keys or client code are needed (this form is a plain POST). -->
  <div class="contact-form__captcha" data-netlify-recaptcha="true"></div>

  <div class="btn-wrapper">
    <Buttons variant="primary">Send it</Buttons>
  </div>
</form>

<style lang="scss">
  .contact-form {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--border-radius-large);
    background: var(--surface-secondary);

    /* The reCAPTCHA box is a fixed 304px wide; shrink it a touch on the
       narrowest phones so it never overflows the card. */
    &__captcha {
      margin-bottom: 1.25rem;

      @media (max-width: 360px) {
        transform: scale(0.88);
        transform-origin: 0 0;
      }
    }
  }
</style>
