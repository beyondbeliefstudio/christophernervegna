---
// Floating "Ask about Chris" chat. Behavior lives in initChat (app.js): it calls
// netlify/functions/ask.mjs and falls back to a small local answer set.
// COMPONENTS
import { Icon } from "astro-icon/components";

// DATA
import { baseData } from "@/data/siteData";

const chips = [
  "Does he hand-code?",
  "How does he use AI?",
  "Has he led a team?",
  "Can he demo a product?",
];
---

<div class="chat" data-chat data-email={baseData.email}>
  <div
    class="chat__panel"
    id="chat-panel"
    role="dialog"
    aria-label="Ask about Chris"
    data-chat-panel
    hidden
  >
    <div class="chat__head">
      <span class="chat__avatar" aria-hidden="true">
        CN
      </span>
      <div>
        <p class="chat__title">Ask about Chris</p>
        <p class="chat__sub">Answers from things he&rsquo;s actually said</p>
      </div>
      <button class="chat__min" type="button" data-chat-toggle aria-label="Minimize chat">
        <Icon name="minus" aria-hidden="true" />
      </button>
    </div>
    <div class="chat__log" data-log aria-live="polite">
      <p class="chat__msg">
        Hey! Ask me anything about Chris: what he builds, how he works, or whether he&rsquo;d fit
        the role you&rsquo;re hiring for.
      </p>
    </div>
    <div class="chat__chips">
      {chips.map(chip => (
        <button class="chat__chip" type="button" data-chip>
          {chip}
        </button>
      ))}
    </div>
    <form class="chat__form" data-form>
      <label class="sr-only" for="chat-input">
        Your question
      </label>
      <input
        class="chat__input"
        id="chat-input"
        name="q"
        maxlength="200"
        autocomplete="off"
        placeholder="Ask anything about Chris"
      />
      <button class="chat__send" type="submit" aria-label="Send">
        <Icon name="arrow-right" aria-hidden="true" />
      </button>
    </form>
  </div>
  <button
    class="chat__toggle"
    type="button"
    data-chat-toggle
    aria-expanded="false"
    aria-controls="chat-panel"
  >
    <span class="chat__toggle-icon" aria-hidden="true">
      <Icon name="chat" />
    </span>
    <span data-chat-label>Ask about Chris</span>
  </button>
</div>

<style lang="scss">
  .chat {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: calc(100vw - 2.5rem);

    &__panel {
      width: 23.75rem;
      max-width: 100%;
      overflow: hidden;
      border-radius: 1.5rem;
      background: var(--surface-primary);
      box-shadow:
        0 0 0 1px rgba(20, 18, 16, 0.06),
        0 24px 60px -12px rgba(20, 18, 16, 0.28);

      &[hidden] {
        display: none;
      }
    }

    &__head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.875rem 1rem;
      background: var(--dark-900);
      color: var(--light-100);
    }

    &__avatar {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--brand-primary);
      color: var(--light-000);
      font-family: var(--primary-family);
      font-size: 0.9375rem;
      font-weight: 700;
    }

    &__title {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.3;
    }

    &__sub {
      font-size: 0.8125rem;
      line-height: 1.3;
      opacity: 0.7;
    }

    &__min {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-left: auto;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      color: var(--light-100);
      cursor: pointer;

      :global(svg) {
        width: 18px;
        height: 18px;
      }
    }

    &__log {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      max-height: min(20rem, 45vh);
      padding: 1rem;
      overflow-y: auto;
      background: var(--light-050);
    }

    /* Messages are added by app.js, so they need the global hook. */
    &__log :global(.chat__msg),
    .chat__msg {
      align-self: flex-start;
      max-width: 85%;
      padding: 0.625rem 0.875rem;
      border-radius: 1rem;
      background: var(--surface-primary);
      box-shadow: 0 0 0 1px rgba(20, 18, 16, 0.05);
      color: var(--content-primary);
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    &__log :global(.chat__msg--you) {
      align-self: flex-end;
      background: var(--dark-900);
      color: var(--light-100);
    }

    &__log :global(.chat__msg--typing) {
      color: var(--content-secondary);
      font-style: italic;
    }

    &__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 0.75rem 1rem 0;
    }

    &__chip {
      padding: 7px 12px;
      border: 0;
      border-radius: var(--border-radius-round);
      background: var(--light-100);
      color: var(--content-primary);
      font: inherit;
      font-size: 0.8125rem;
      cursor: pointer;

      &:hover {
        color: var(--brand-primary-dark);
      }
    }

    &__form {
      display: flex;
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.75rem 1rem 1rem;
    }

    &__input {
      flex: 1;
      min-width: 0;
      padding: 0.75rem 0.875rem;
      font-size: 0.9375rem;
    }

    &__send {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: var(--brand-primary);
      color: var(--light-000);
      cursor: pointer;

      :global(svg) {
        width: 18px;
        height: 18px;
      }
    }

    &__toggle {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 9px 20px 9px 9px;
      border: 0;
      border-radius: var(--border-radius-round);
      background: var(--dark-900);
      box-shadow: 0 16px 36px -12px rgba(20, 18, 16, 0.55);
      color: var(--light-100);
      font: inherit;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
    }

    &__toggle-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--brand-primary);
      color: var(--light-000);

      :global(svg) {
        width: 18px;
        height: 18px;
      }
    }

    @media (max-width: 480px) {
      &__toggle {
        padding: 9px;

        [data-chat-label] {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
        }

        &[aria-expanded="true"] {
          padding: 9px 18px 9px 9px;

          [data-chat-label] {
            position: static;
            width: auto;
            height: auto;
            clip: auto;
          }
        }
      }
    }
  }
</style>
