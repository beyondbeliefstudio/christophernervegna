---
// COMPONENTS
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import OpenToWork from "@/components/OpenToWork.astro";
import ThreeInOne from "@/components/ThreeInOne.astro";
import Work from "@/components/Work.astro";
import About from "@/components/About.astro";
import Build from "@/components/Build.astro";
import AI from "@/components/AI.astro";
import WorkingWithMe from "@/components/WorkingWithMe.astro";
import OffTheClock from "@/components/OffTheClock.astro";
import MessageForm from "@/components/MessageForm.astro";
import Contact from "@/components/Contact.astro";

// DATA
import { baseData } from "@/data/siteData";
---

<Layout pageTitle={baseData.title} description={baseData.description}>
  <Hero />
  <OpenToWork />
  <ThreeInOne />
  <Work />
  <About />
  <Build />
  <AI />
  <WorkingWithMe />
  <OffTheClock />
  <MessageForm />
  <Contact />
</Layout>
