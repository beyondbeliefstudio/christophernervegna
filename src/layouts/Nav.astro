---
// One-page progress navigation (adapted from Osmo Supply's "One Page Progress
// Navigation"). Each link points at a homepage section carrying
// data-progress-nav-anchor; the light pill slides to whichever section is
// mid-screen (initProgressNav in app.js). On other pages the links just go home.
// On phones the links hide and a menu button grows the same dark bar into a
// sheet of section links (initMobileMenu in app.js).
// DATA
import { navData, contactHref } from "@/data/navData";

const targetOf = (href: string) => "#" + href.split("#")[1];
---

<nav class="progress-nav" aria-label="Main" data-reveal="drop">
  <div class="progress-nav__inner">
    <a href="/" class="progress-nav__logo" aria-label="Chris Nervegna, home">
      Chris Nervegna<span class="logo-stop" aria-hidden="true"></span>
    </a>
    <div class="progress-nav__wrapper">
      <div data-progress-nav-list class="progress-nav__list">
        <div class="progress-nav__indicator" aria-hidden="true"></div>
        <div
          data-progress-nav-target="#top"
          class="progress-nav__btn is--before"
          aria-hidden="true"
        ></div>
        {navData.map(item => (
          <a
            data-progress-nav-target={targetOf(item.href)}
            href={item.href}
            class="progress-nav__btn"
          >
            <span class="progress-nav__btn-text">{item.title}</span>
            <span class="progress-nav__btn-text is--duplicate" aria-hidden="true">
              {item.title}
            </span>
          </a>
        ))}
        <div
          data-progress-nav-target={targetOf(contactHref)}
          class="progress-nav__btn is--after"
          aria-hidden="true"
        ></div>
      </div>
    </div>
    <button
      type="button"
      class="progress-nav__menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>
        Open menu
      </span>
      <span class="progress-nav__menu-icon" aria-hidden="true">
        <i></i>
        <i></i>
      </span>
    </button>
    <a href={contactHref} class="progress-nav__contact-btn">
      <span class="progress-nav__btn-text">Say hi</span>
      <span class="progress-nav__btn-text is--duplicate" aria-hidden="true">
        Say hi
      </span>
    </a>

    <div id="mobile-menu" class="progress-nav__sheet" data-menu-sheet hidden>
      <ul class="progress-nav__sheet-list">
        {navData.map(item => (
          <li>
            <a
              href={item.href}
              class="progress-nav__sheet-link"
              data-menu-target={targetOf(item.href)}
            >
              <span class="progress-nav__sheet-title">{item.title}</span>
              {item.ask && <span class="progress-nav__sheet-ask">{item.ask}</span>}
            </a>
          </li>
        ))}
      </ul>
      <a href={contactHref} class="progress-nav__sheet-cta">
        Say hi
      </a>
    </div>
  </div>
</nav>

<style lang="scss">
  .progress-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    padding: 1rem var(--site--margin) 0;
    font-size: 0.9375rem;
    pointer-events: none;

    /* One dark floating bar: logo left, sliding links centered, CTA right. */
    &__inner {
      display: grid;
      /* Links sit centered between the logo and the CTA, so the gaps on both
         sides match even though the logo is wider than the button. */
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.75rem;
      max-width: 53.75rem;
      margin: 0 auto;
      padding: 7px;
      border-radius: 1.25rem;
      background: var(--dark-900);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.04) inset,
        0 18px 40px -16px rgba(20, 18, 16, 0.55);
      pointer-events: auto;
    }

    &__logo {
      justify-self: start;
      display: flex;
      align-items: center;
      height: 3rem;
      padding-left: 0.875rem;
      color: var(--light-100);
      font-family: var(--primary-family);
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        color: var(--light-100);
      }

      .logo-stop {
        position: relative;
        top: 4px;
        width: 7px;
        height: 7px;
        margin-left: 2px;
      }
    }

    &__wrapper {
      justify-self: center;
    }

    &__list {
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;
      border-radius: 0.75rem;
    }

    &__indicator {
      position: absolute;
      left: -3em;
      z-index: 2;
      width: 3em;
      height: 3em;
      border-radius: 0.75rem;
      background-color: var(--light-100);
      transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &__btn {
      position: relative;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 3em;
      padding: 0 1.1em;
      overflow: hidden;
      color: var(--light-100);
      opacity: 0.82;
      text-decoration: none;
      cursor: pointer;
      transition:
        color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.6s;

      &:hover {
        opacity: 1;
        color: var(--light-100);
      }

      &.is--active {
        color: var(--content-primary);
        opacity: 1;
      }

      &.is--before,
      &.is--after {
        position: absolute;
        z-index: 1;
        width: 3em;
        padding: 0;
      }

      &.is--before {
        right: 100%;
      }

      &.is--after {
        left: 100%;
      }
    }

    &__btn-text {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      font-weight: 500;
      white-space: nowrap;
      transform: translateY(0%) rotate(0.001deg);
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);

      &.is--duplicate {
        position: absolute;
        top: 100%;
      }
    }

    &__btn:hover &__btn-text,
    &__contact-btn:hover &__btn-text {
      transform: translateY(-100%) rotate(0.001deg);
    }

    &__contact-btn {
      position: relative;
      justify-self: end;
      display: flex;
      flex-direction: column;
      height: 3rem;
      padding: 0 1.6em;
      overflow: hidden;
      border-radius: 0.8125rem;
      background-color: var(--brand-primary);
      color: var(--content-on-primary);
      font-size: 1rem;
      text-decoration: none;
      transition:
        background-color 0.4s,
        box-shadow 0.4s;

      &:hover {
        color: var(--content-on-primary);
      }

      .progress-nav__btn-text.is--duplicate {
        left: 0;
        right: 0;
      }
    }

    /* When the contact band is on screen, the CTA lights up as the current item. */
    &.is--on-red .progress-nav__contact-btn {
      box-shadow:
        0 0 0 2px var(--dark-900),
        0 0 0 4px var(--light-100);
    }

    /* Mobile menu: hidden on desktop. */
    &__menu,
    &__sheet {
      display: none;
    }

    @media (max-width: 860px) {
      padding-top: 0.625rem;

      &__inner {
        grid-template-columns: 1fr auto auto;
        gap: 0.5rem;
      }

      &__menu {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        padding: 0;
        border: 0;
        border-radius: 0.8125rem;
        background: rgba(255, 255, 255, 0.09);
        color: var(--light-100);
        cursor: pointer;
      }

      /* Two lines that cross into an X when open. */
      &__menu-icon {
        position: relative;
        width: 1.125rem;
        height: 0.625rem;

        i {
          position: absolute;
          left: 0;
          width: 100%;
          height: 2px;
          border-radius: 2px;
          background: currentColor;
          transition:
            transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            top 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        i:first-child {
          top: 0;
        }

        i:last-child {
          top: calc(100% - 2px);
        }
      }

      &__menu[aria-expanded="true"] &__menu-icon i {
        top: calc(50% - 1px);
      }

      &__menu[aria-expanded="true"] &__menu-icon i:first-child {
        transform: rotate(45deg);
      }

      &__menu[aria-expanded="true"] &__menu-icon i:last-child {
        transform: rotate(-45deg);
      }

      /* The sheet is part of the same dark bar, spanning its full width. */
      &__sheet {
        display: block;
        grid-column: 1 / -1;
        max-height: calc(100svh - 6.5rem);
        overflow: hidden auto;

        &[hidden] {
          display: none;
        }
      }

      &__sheet-list {
        margin: 0;
        padding: 0.5rem 0.5rem 0;
        list-style: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      &__sheet-link {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0.75rem 0.5rem 0.75rem 1.5rem;
        border-radius: 0.75rem;
        color: var(--light-100);
        text-decoration: none;

        &:hover,
        &:focus-visible {
          background: rgba(255, 255, 255, 0.06);
          color: var(--light-100);
        }

        /* The section on screen gets a Campari dot. */
        &::before {
          content: "";
          position: absolute;
          top: 1.35rem;
          left: 0.5rem;
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: var(--brand-primary);
          transform: scale(0);
          transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        &.is--active::before {
          transform: scale(1);
        }
      }

      &__sheet-title {
        font-family: var(--primary-family);
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }

      &__sheet-ask {
        color: color-mix(in srgb, var(--light-100) 70%, transparent);
        font-size: 0.9375rem;
        font-style: italic;
      }

      &__sheet-cta {
        display: none;
      }

      &__wrapper {
        display: none;
      }

      &__logo {
        padding-left: 0.625rem;
        font-size: 1.25rem;
      }
    }

    /* Narrow phones: "Say hi" moves from the bar into the sheet. */
    @media (max-width: 374px) {
      &__inner {
        grid-template-columns: 1fr auto;
      }

      &__contact-btn {
        display: none;
      }

      &__sheet-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 3rem;
        margin: 0.5rem;
        border-radius: 0.8125rem;
        background: var(--brand-primary);
        color: var(--content-on-primary);
        font-weight: 500;
        text-decoration: none;

        &:hover {
          color: var(--content-on-primary);
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      &__indicator,
      &__btn-text,
      &__btn,
      &__menu-icon i,
      &__sheet-link::before {
        transition: none;
      }
    }
  }
</style>
